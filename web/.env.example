# ── Base de dados: a MESMA do Cyclos (onde já estão as tabelas zsgo_*) ──
# Ex.: postgresql://utilizador:senha@ip-do-postgres:5432/cyclos
DATABASE_URL=

# ── Keycloak (já existente em auth.lusopay.com) ─────────────────────────
# Criar no realm um client "faturacao-web" (confidencial) com o Redirect
# URI abaixo — igual ao financial (ver README, secção 3).
KEYCLOAK_ISSUER=https://auth.lusopay.com/realms/lusopay
KEYCLOAK_CLIENT_ID=faturacao-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://faturacao.lusopay.com/api/auth/callback

# ── Primeiro administrador (usado só pelo seed) ─────────────────────────
# Mesmo email da conta Keycloak com que vai entrar.
PRIMEIRO_ADMIN_EMAIL=
PRIMEIRO_ADMIN_NOME=

# ── Acesso de emergência (só enquanto o Keycloak não estiver acessível) ─
# Hash argon2id da senha, em base64 (ver README, "Acesso de emergência").
ADMIN_LOCAL_LOGIN_ENABLED=false
ADMIN_LOCAL_LOGIN_USERNAME=
ADMIN_LOCAL_LOGIN_PASSWORD_HASH_B64=

# ── ZSGO, Cyclos e queries ──────────────────────────────────────────────
# Vêm do MESMO config.properties do programa em Java (zsgo.*, cyclos.invoice.*,
# invoice.*, billing.query, creditnote.query, source.clients.verify.query).
# Copiar esse ficheiro para esta pasta (ou indicar outro caminho aqui).
# O db.url/db.user/db.password dele não são usados (usa-se DATABASE_URL).
CONFIG_PROPERTIES_HOST=./config.properties

# ── Tarefas agendadas ───────────────────────────────────────────────────
# O agendador corre dentro da aplicação (não é preciso o agendador.bat).
# Pode ficar ligado ao mesmo tempo que o do Java: as tarefas nunca correm
# duas vezes. false = desligado nesta aplicação.
AGENDADOR=true
FUSO_HORARIO=Europe/Lisbon

# 127.0.0.1 se o Caddy estiver nesta VM; 0.0.0.0 (ou o IP da rede) se
# estiver noutra VM.
WEB_BIND_ADDRESS=127.0.0.1
TAG=latest
